{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xmake: configure debug",
      "type": "shell",
      "command": "xmake",
      "args": ["f", "-m", "debug", "-y"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "xmake: build fastxl (debug)",
      "type": "shell",
      "command": "xmake",
      "args": ["build", "-y", "fastxl_cli"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "xmake: configure debug",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
