# Local build output and tool caches
build/
.xmake/
.cache/
.vscode/.cache/
.vscode/compile_commands.json
compile_commands.json

# Python caches and link intermediates
__pycache__/
*.pyc
*.exp

# Local development tests and benchmarks are not shipped
projects/tests/
projects/bench/

