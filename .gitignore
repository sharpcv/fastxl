# Local build output and tool caches
build/
.xmake/
.cache/
.vscode/.cache/
.vscode/compile_commands.json
compile_commands.json

# Local DSH plugin experiments (e.g. plugins/fastxl-workbench) are developed in
# this workspace but are not part of the fastxl release tree; keep bundled
# binaries such as plugins/*/bin/fastxl-cli.exe out of `git add .`.
plugins/

# Python caches and link intermediates
__pycache__/
*.pyc
*.exp

# Test and benchmark sources are shipped so CI can run them; the generated
# fixtures and benchmark data stay local (recreate with gen_fixtures.py).
projects/tests/*
!projects/tests/xmake.lua
!projects/tests/*.cpp
!projects/tests/*.hpp
!projects/tests/*.py
!projects/tests/*.supp
!projects/tests/fixtures/
projects/tests/fixtures/*
!projects/tests/fixtures/gen_fixtures.py

projects/bench/*
!projects/bench/*.py
!projects/bench/*.cpp
!projects/bench/*.hpp
!projects/bench/xmake.lua
!projects/bench/*.md
!projects/bench/write_bench_rs/
projects/bench/write_bench_rs/*
!projects/bench/write_bench_rs/Cargo.toml
!projects/bench/write_bench_rs/Cargo.lock
!projects/bench/write_bench_rs/src/
projects/bench/write_bench_rs/src/*
!projects/bench/write_bench_rs/src/*.rs
!projects/bench/data/
projects/bench/data/*
!projects/bench/data/*.py

# Python extension artifacts and link intermediates
bindings/python/fastxl/_fastxl.lib
bindings/python/fastxl/_fastxl*.pyd
bindings/python/fastxl/_fastxl*.so

# Staged skill artifacts are produced by projects/tools/stage_skill.py
skill/bin/*
skill/python/fastxl/_fastxl.*
!skill/python/fastxl/__init__.py
skill/reference/*
!skill/reference/.gitkeep

skill/python/fastxl/py.typed
