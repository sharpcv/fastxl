        "row": {
          "type": "integer"
        },
        "col": {
          "type": "integer"
        },
        "type": {
          "type": "string"
        },
        "field": {
          "enum": [
            "text",
            "formula"
          ]
        },
        "text": {
          "type": "string"
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "text"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "Search": {
      "type": "object",
      "required": [
        "version",
        "ok",
        "file",
        "query",
        "matches",
        "match_count"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/Version"
        },
        "ok": {
