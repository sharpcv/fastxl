        }
      },
      "additionalProperties": true
    },
    "Budget": {
      "type": "object",
      "description": "Present when --max-bytes/max_bytes is set. Reports what was folded to reach the cap; the payload itself always stays valid JSON.",
      "required": [
        "max_bytes",
        "applied",
        "bytes",
        "within_budget"
      ],
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "applied": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "description": "Serialized size of the payload, including this object."
        },
        "within_budget": {
          "type": "boolean",
          "description": "False when even the last stage could not meet the cap."
        },
        "stages": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Folded sections in order, with the number of entries removed or damped."
        },
        "stages_count": {
          "type": "integer",
          "description": "Stage count when the per-stage detail was dropped to fit."
        },
        "folded_columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BudgetColumn"
          }
        },
        "folded_columns_count": {
          "type": "integer"
        },
        "dropped_rows": {
          "type": "integer"
        },
        "dropped_matches": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
