        },
        "file": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "regex": {
          "type": "boolean"
        },
        "ignore_case": {
          "type": "boolean"
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchMatch"
          }
        },
        "match_count": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        },
        "searched_cells": {
          "type": "integer"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        }
      },
      "additionalProperties": true
    }
  }
