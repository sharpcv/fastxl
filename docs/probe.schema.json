{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastxl.local/probe-v1.schema.json",
  "title": "fastxl machine-facing JSON, version 1",
  "description": "Success and error payloads emitted by info, probe, schema, preview, search and errors. Objects are intentionally open: new optional fields may be added within version 1.",
  "oneOf": [
    {
      "$ref": "#/$defs/Error"
    },
    {
      "$ref": "#/$defs/Info"
    },
    {
      "$ref": "#/$defs/Probe"
    },
    {
      "$ref": "#/$defs/Schema"
    },
    {
      "$ref": "#/$defs/Preview"
    },
    {
      "$ref": "#/$defs/Errors"
    },
    {
      "$ref": "#/$defs/Search"
    }
  ],
  "$defs": {
    "Version": {
      "const": 1
    },
    "Error": {
      "type": "object",
      "required": [
        "version",
        "ok",
        "error"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/Version"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "exit_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "command": {
              "type": "string"
            },
            "file": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "Errors": {
      "type": "object",
      "required": [
        "version",
        "ok",
        "exit_codes",
        "error_codes"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/Version"
        },
        "ok": {
          "const": true
        },
        "exit_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExitCode"
          }
        },
        "error_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErrorCode"
          }
        }
      },
      "additionalProperties": true
    },
    "ExitCode": {
      "type": "object",
      "required": [
        "code",
        "name",
        "description"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ErrorCode": {
      "type": "object",
      "required": [
        "name",
        "exit_code",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "SheetInfo": {
      "type": "object",
      "required": [
        "index",
        "name",
        "kind",
        "state"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "sheet_id": {
          "type": "integer"
        },
        "rel_id": {
          "type": "string"
        },
        "part": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "worksheet",
            "chartsheet"
          ]
        },
        "state": {
          "enum": [
            "visible",
            "hidden",
            "very_hidden"
          ]
        },
        "uncompressed_bytes": {
          "type": "integer"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableInfo"
          }
        },
        "tables_truncated": {
          "type": "boolean"
        },
        "comments_count": {
          "type": "integer"
        },
        "pivot_tables_count": {
          "type": "integer"
        },
        "charts_count": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "Info": {
      "type": "object",
      "required": [
        "version",
        "ok",
        "file",
        "size_bytes",
        "sheets"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/Version"
        },
        "ok": {
          "const": true
        },
        "file": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer"
        },
        "date1904": {
          "type": "boolean"
        },
        "shared_strings": {
          "type": "integer"
        },
        "defined_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DefinedName"
          }
        },
        "defined_names_truncated": {
          "type": "boolean"
        },
        "sheets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SheetInfo"
          }
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        }
      },
      "additionalProperties": true
    },
    "Numeric": {
      "type": "object",
      "properties": {
        "any": {
          "type": "boolean"
        },
        "integers": {
          "type": "integer"
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "sum": {
          "type": [
            "number",
            "null"
          ]
        },
        "non_finite": {
          "type": "integer"
        },
        "int_min": {
          "type": "integer"
        },
        "int_max": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "ValueCount": {
      "type": "object",
      "required": [
        "value",
        "count"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "DefinedName": {
      "type": "object",
      "required": [
        "name",
        "ref"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "local_sheet_index": {
          "type": "integer"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "TableInfo": {
      "type": "object",
      "required": [
        "name",
        "ref",
        "columns",
        "header_rows"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "header_rows": {
          "type": "integer"
        },
        "columns_truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "CommentItem": {
      "type": "object",
      "required": [
        "ref",
        "author",
        "text"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "CommentsInfo": {
      "type": "object",
      "required": [
        "count",
        "items",
        "truncated"
      ],
      "properties": {
        "count": {
          "type": "integer"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommentItem"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "PivotTableInfo": {
      "type": "object",
      "required": [
        "name",
        "part",
        "cache_id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "part": {
          "type": "string"
        },
        "cache_id": {
          "type": "integer"
        },
        "source_sheet": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ChartRef": {
      "type": "object",
      "required": [
        "sheet",
        "ref"
      ],
      "properties": {
        "sheet": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ChartInfo": {
      "type": "object",
      "required": [
        "part",
        "refs"
      ],
      "properties": {
        "part": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartRef"
          }
        }
      },
      "additionalProperties": true
    },
    "FilterCondition": {
      "type": "object",
      "required": [
        "operator",
        "value"
      ],
      "properties": {
        "operator": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "FilterColumn": {
      "type": "object",
      "required": [
        "column",
        "values",
        "custom"
      ],
      "properties": {
        "column": {
          "type": "integer"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FilterCondition"
          }
        }
      },
      "additionalProperties": true
    },
    "FormulaLink": {
      "type": "object",
      "required": [
        "cell",
        "formula",
        "refs"
      ],
      "properties": {
        "cell": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartRef"
          }
        }
      },
      "additionalProperties": true
    },
    "JoinKey": {
      "type": "object",
      "required": [
        "left_sheet",
        "left_column",
        "left_name",
        "right_sheet",
        "right_column",
        "right_name",
        "reason"
      ],
      "properties": {
        "left_sheet": {
          "type": "string"
        },
        "left_column": {
          "type": "integer"
        },
        "left_name": {
          "type": "string"
        },
        "right_sheet": {
          "type": "string"
        },
        "right_column": {
          "type": "integer"
        },
        "right_name": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "same_name",
            "value_overlap"
          ]
        },
        "overlap": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "MetadataBlock": {
      "type": "object",
      "properties": {
        "merged_cells": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merged_cells_truncated": {
          "type": "boolean"
        },
        "hidden_rows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "hidden_rows_truncated": {
          "type": "boolean"
        },
        "filter_columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FilterColumn"
          }
        },
        "uncached_formulas": {
          "type": "integer"
        },
        "formula_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormulaLink"
          }
        },
        "formula_links_truncated": {
          "type": "boolean"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableInfo"
          }
        },
        "tables_truncated": {
          "type": "boolean"
        },
        "comments": {
          "$ref": "#/$defs/CommentsInfo"
        },
        "pivot_tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PivotTableInfo"
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartInfo"
          }
        }
      },
      "additionalProperties": true
    },
    "Column": {
      "type": "object",
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "original_name": {
          "type": "string"
        },
        "header": {
          "type": "string"
        },
        "type": {
          "enum": [
            "null",
            "integer",
            "number",
            "text",
            "boolean",
            "error",
            "date",
            "datetime",
            "time",
            "mixed",
            "invalid"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "non_null": {
          "type": "integer"
        },
        "nulls": {
          "type": "integer"
        },
        "distinct": {
          "type": "integer"
        },
        "distinct_capped": {
          "type": "boolean"
        },
        "numeric": {
          "$ref": "#/$defs/Numeric"
        },
        "text": {
          "type": "object"
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sample_truncated": {
          "type": "boolean"
        },
        "top_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValueCount"
          }
        },
        "enum_values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enum_values_truncated": {
          "type": "boolean"
        },
        "num_fmt": {
          "type": "string"
        },
        "style_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formula_cells": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "SheetMeta": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "index": {
          "type": "integer"
        },
        "state": {
          "enum": [
            "visible",
            "hidden",
            "very_hidden"
          ]
        },
        "header_row": {
          "type": "integer"
        },
        "header_rows": {
          "type": "integer"
        },
        "rows_scanned": {
          "type": "integer"
        },
        "data_rows": {
          "type": "integer"
        },
        "max_row": {
          "type": "integer"
        },
        "max_col": {
          "type": "integer"
        },
        "empty_rows": {
          "type": "integer"
        },
        "ragged_rows": {
          "type": "integer"
        },
        "merged_ranges": {
          "type": "integer"
        },
        "error_cells": {
          "type": "integer"
        },
        "has_formulas": {
          "type": "boolean"
        },
        "parallel": {
          "type": "boolean"
        },
        "used_range": {
          "type": "string"
        },
        "auto_filter": {
          "type": "string"
        },
        "pane_top_row": {
          "type": "integer"
        },
        "hidden_columns": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "merged_cells": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merged_cells_truncated": {
          "type": "boolean"
        },
        "hidden_rows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "hidden_rows_truncated": {
          "type": "boolean"
        },
        "filter_columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FilterColumn"
          }
        },
        "uncached_formulas": {
          "type": "integer"
        },
        "formula_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormulaLink"
          }
        },
        "formula_links_truncated": {
          "type": "boolean"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableInfo"
          }
        },
        "tables_truncated": {
          "type": "boolean"
        },
        "comments": {
          "$ref": "#/$defs/CommentsInfo"
        },
        "pivot_tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PivotTableInfo"
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartInfo"
          }
        },
        "defined_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DefinedName"
          }
        },
        "defined_names_truncated": {
          "type": "boolean"
        },
        "range": {
          "type": "string"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SheetMeta"
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "Probe": {
      "type": "object",
      "required": [
        "version",
        "ok",
        "sheet_name",
        "columns"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/Version"
        },
        "ok": {
          "const": true
        },
        "file": {
          "type": "string"
        },
        "sheet_name": {
          "type": "string"
        },
        "sheet_index": {
          "type": "integer"
        },
        "header_row": {
          "type": "integer"
        },
        "header_rows": {
          "type": "integer"
        },
        "header_auto": {
          "type": "boolean"
        },
        "rows_scanned": {
          "type": "integer"
        },
        "data_rows": {
          "type": "integer"
        },
        "max_row": {
          "type": "integer"
        },
        "max_col": {
          "type": "integer"
        },
        "empty_rows": {
          "type": "integer"
        },
        "ragged_rows": {
          "type": "integer"
        },
        "merged_ranges": {
          "type": "integer"
        },
        "error_cells": {
          "type": "integer"
        },
        "has_formulas": {
          "type": "boolean"
        },
        "parallel": {
          "type": "boolean"
        },
        "merged_cells": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merged_cells_truncated": {
          "type": "boolean"
        },
        "hidden_rows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "hidden_rows_truncated": {
          "type": "boolean"
        },
        "filter_columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FilterColumn"
          }
        },
        "uncached_formulas": {
          "type": "integer"
        },
        "formula_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormulaLink"
          }
        },
        "formula_links_truncated": {
          "type": "boolean"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableInfo"
          }
        },
        "tables_truncated": {
          "type": "boolean"
        },
        "comments": {
          "$ref": "#/$defs/CommentsInfo"
        },
        "pivot_tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PivotTableInfo"
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartInfo"
          }
        },
        "defined_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DefinedName"
          }
        },
        "range": {
          "type": "string"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SheetMeta"
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        }
      },
      "additionalProperties": true
    },
    "Schema": {
      "type": "object",
      "required": [
        "version",
        "ok",
        "file",
        "format",
        "sheets"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/Version"
        },
        "ok": {
          "const": true
        },
        "file": {
          "type": "string"
        },
        "format": {
          "enum": [
            "xlsx",
            "csv",
            "jsonl"
          ]
        },
        "header_auto": {
          "type": "boolean"
        },
        "sheets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SheetMeta"
          }
        },
        "defined_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DefinedName"
          }
        },
        "defined_names_truncated": {
          "type": "boolean"
        },
        "join_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JoinKey"
          }
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        }
      },
      "additionalProperties": true
    },
    "PreviewCell": {
      "type": "object",
      "required": [
        "col",
        "letter",
        "ref",
        "type",
        "text"
      ],
      "properties": {
        "col": {
          "type": "integer"
        },
        "letter": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "formula": {
          "type": "string"
        },
